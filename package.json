{
  "name": "workmw-app",
  "version": "1.0.0",
  "description": "WorkMw Vacancy Admin",
  "author": "Kwacha Consultants Limited",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.workmw.app",
    "productName": "WorkMw",
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "WorkMw-Setup-${version}.${ext}"
  }
}